<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-ios;net10.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);NETSDK1202;NU5123;CS8767</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Datadog.MAUI.iOS.Core</AssemblyName>

    <PackageId>Datadog.MAUI.iOS.Core</PackageId>
    <Authors>Datadog</Authors>
    <Description>.NET Bindings for Datadog iOS SDK Core framework</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DataDog/dd-sdk-maui</RepositoryUrl>
    <PackageTags>.NET MAUI iOS Datadog Mobile Binding Core</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <XCFrameworkPath>../artifacts/DatadogCore.xcframework</XCFrameworkPath>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DatadogInternal\DatadogInternal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="$(XCFrameworkPath)">
      <Kind>Framework</Kind>
      <Frameworks>Foundation UIKit SystemConfiguration Network</Frameworks>
      <SmartLink>True</SmartLink>
      <ForceLoad>True</ForceLoad>
      <LinkWithSwiftSystemLibraries>True</LinkWithSwiftSystemLibraries>
      <!-- Swift class stubs: these ObjC classes are emitted as class stubs (in __objc_stublist)
           by the Swift compiler with library evolution enabled. The ObjC runtime resolves them
           at load time, but the static linker needs -U to defer resolution. -->
      <LinkerFlags>-Wl,-U,_OBJC_CLASS_$_DDConfiguration -Wl,-U,_OBJC_CLASS_$_DDSite -Wl,-U,_OBJC_CLASS_$_DDTrackingConsent -Wl,-U,_OBJC_CLASS_$_DDURLSessionInstrumentationConfiguration -Wl,-U,_OBJC_CLASS_$_DDURLSessionInstrumentationFirstPartyHostsTracing</LinkerFlags>
    </NativeReference>
  </ItemGroup>
</Project>
